{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varuna.local/contracts/segment.schema.json",
  "title": "Varuna Segment",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "geometry", "fromNode", "toNode", "lengthM", "terrainPrior", "drainageVulnerability", "source", "bundleVersion"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "geometry": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/point"}},
    "fromNode": {"type": "string", "minLength": 1},
    "toNode": {"type": "string", "minLength": 1},
    "lengthM": {"type": "number", "exclusiveMinimum": 0},
    "terrainPrior": {"$ref": "#/$defs/nullableUnit"},
    "drainageVulnerability": {"$ref": "#/$defs/nullableUnit"},
    "source": {"type": "string", "minLength": 1},
    "bundleVersion": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "point": {"type": "array", "prefixItems": [{"type": "number", "minimum": -180, "maximum": 180}, {"type": "number", "minimum": -90, "maximum": 90}], "items": false, "minItems": 2, "maxItems": 2},
    "nullableUnit": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
  }
}
