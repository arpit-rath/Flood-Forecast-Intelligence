{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varuna.local/contracts/report.schema.json",
  "title": "Varuna Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "segmentId", "point", "createdAt", "capturedAt", "imageKey", "reviewStatus", "observations", "modelConfidence", "source"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "segmentId": {"type": "string", "minLength": 1},
    "point": {"type": "array", "prefixItems": [{"type": "number", "minimum": -180, "maximum": 180}, {"type": "number", "minimum": -90, "maximum": 90}], "items": false, "minItems": 2, "maxItems": 2},
    "createdAt": {"type": "string", "format": "date-time"},
    "capturedAt": {"type": ["string", "null"], "format": "date-time"},
    "imageKey": {"type": "string", "minLength": 1},
    "reviewStatus": {"enum": ["Pending Review", "Accepted", "Rejected", "Needs Manual Review"]},
    "observations": {"type": "object"},
    "modelConfidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "source": {"type": "string", "minLength": 1}
  }
}
